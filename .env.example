# EcoFlow account used in the official app
ECOFLOW_EMAIL=you@example.com
ECOFLOW_PASSWORD=your-app-password

# Serial number from the station body / EcoFlow app (DELTA 3 1500 often starts with D361/D362/D381)
ECOFLOW_SN=D361ZXXXXXXXXXXX

# global | eu | asia
ECOFLOW_REGION=global

# HTTP bind for the iPhone Scriptable widget
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8080

# Optional shared secret: Scriptable must send header X-EcoFlow-Token
BRIDGE_TOKEN=
